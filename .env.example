# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini

# Set to 1 to replay cached responses instead of calling the API.
# Demo-day insurance: works with no network at all.
MOCK_LLM=0

# --- Database ---
# SQLite for the MVP. Swap for a postgresql:// URL to move to Postgres.
DATABASE_URL=sqlite:///./bis_sarthi.db

# --- Retrieval (runs locally on CPU, no API key needed) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=BAAI/bge-reranker-base
FAISS_INDEX_PATH=./data/index
RETRIEVAL_TOP_K=20
RERANK_TOP_N=4
# Below this rerank score the assistant refuses instead of calling the LLM.
RELEVANCE_THRESHOLD=0.25

# --- Server ---
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=5
