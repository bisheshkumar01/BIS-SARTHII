# Secrets
.env
*.key
# Generated by scripts/make_vercel_env.py — contains a real API key, never commit it.
vercel-env.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node
node_modules/
dist/
.vite/

# Data — raw sources and built indexes are large; keep seed CSVs only
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/index/*
!data/index/.gitkeep
data/uploads/

# Database
*.db
*.sqlite3

# ML model cache. The leading slash anchors this to the repo root: without it the pattern
# also matched backend/app/models/, which silently kept the SQLAlchemy models out of every
# commit and crashed the deployed function on an import it could not resolve.
.cache/
/models/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
